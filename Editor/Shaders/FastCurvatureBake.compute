#pragma kernel ClearGBuffer
#pragma kernel RasterInterior
#pragma kernel RasterConservativeDistance
#pragma kernel RasterConservativeOwner
#pragma kernel ResolveGBuffer
#pragma kernel EvaluateCurvature
#pragma kernel Downsample
#pragma kernel Blur
#pragma kernel JfaInit
#pragma kernel JfaStep
#pragma kernel JfaApply

// All 2D images are StructuredBuffers indexed as y * width + x.
// Texel (x, y) covers UV ((x + 0.5) / width, (y + 0.5) / width); y = 0 is v = 0.

// ---------------------------------------------------------------------------
// Mesh (world space)
// ---------------------------------------------------------------------------
StructuredBuffer<float3> _Positions;
StructuredBuffer<float3> _Normals;
StructuredBuffer<float2> _UVs;
StructuredBuffer<uint>   _Patches;          // smooth-patch id per vertex
StructuredBuffer<uint>   _PatchComponents;  // connected-part id per patch
StructuredBuffer<uint>   _Triangles;
StructuredBuffer<uint2>  _RasterTiles;      // (triangle, tileX | tileY << 16), see UvLayout.cs

// ---------------------------------------------------------------------------
// G-buffer
//   _GOwner:    triangle owning the texel (NoOwner = empty). Chosen with atomics
//               so the result does not depend on thread scheduling.
//   _GDist:     conservative pass scratch: smallest distance² (as uint) of a
//               candidate triangle. Shares its buffer with _GNormal.
//   _GPosition: xyz = world position, w = patch id + 1 (0 = empty texel)
//   _GNormal:   octahedral-encoded normal (16 + 16 bit): shading normal, or the
//               face normal for the geometry estimator
// ---------------------------------------------------------------------------
RWStructuredBuffer<uint>   _GOwner;
RWStructuredBuffer<uint>   _GDist;
RWStructuredBuffer<float4> _GPosition;
RWStructuredBuffer<uint>   _GNormal;

// ---------------------------------------------------------------------------
// Open-addressing spatial hash cell entry (see SpatialHashGrid.cs, 16 bytes)
// ---------------------------------------------------------------------------
struct CellEntry
{
    uint keyLo; // cx (21 bits) | (cy & 0x7FF) << 21
    uint keyHi; // (cy >> 11) (10 bits) | (cz << 10) (21 bits)
    uint start;
    uint count; // 0 = empty slot
};

// ---------------------------------------------------------------------------
// Surface samples in an exact hashed grid (see SurfaceSampler.cs, 24 bytes)
// ---------------------------------------------------------------------------
struct SurfaceSample
{
    float3 position;
    uint   normalOct;
    uint   patchId;
    float  weight;
};
StructuredBuffer<SurfaceSample> _Samples;
StructuredBuffer<CellEntry>     _SampleCells;

// ---------------------------------------------------------------------------
// Hard/sharp convex edge segments in a second exact hashed grid (60 bytes)
// ---------------------------------------------------------------------------
struct EdgeSegment
{
    float3 a;
    float3 b;
    float3 faceNormalA;
    float3 faceNormalB;
    float  value;      // +1 = 90-degree convex (or full sharp mask), -1 = 90-degree concave
    uint   patchA;     // smooth patches of the two adjacent faces
    uint   patchB;
};
StructuredBuffer<EdgeSegment> _Edges;
StructuredBuffer<CellEntry>   _EdgeCells;

// ---------------------------------------------------------------------------
// Images: x = curvature value, y = UV island id + 1 (0 = empty texel).
// Island ids stay exact in float up to 2^24.
// ---------------------------------------------------------------------------
StructuredBuffer<uint>     _TriangleIslands;   // UV island id per triangle, see UvLayout.cs
StructuredBuffer<float>    _TriangleBevelCore; // SharpConvex mode: bevel-interior strength per triangle
RWStructuredBuffer<float2> _Result;
StructuredBuffer<float2>   _Src;
RWStructuredBuffer<float2> _Dst;

// JFA dilation seed buffers: packed x | (y << 16), 0xFFFFFFFF = no seed.
StructuredBuffer<uint>     _JfaSrc;
RWStructuredBuffer<uint>   _JfaDst;

// ---------------------------------------------------------------------------
// Parameters
// ---------------------------------------------------------------------------
uint   _Width;            // G-buffer / evaluation resolution (power of 2 >= 256)
uint   _TileSize;         // raster tile edge in pixels
uint   _SrcWidth;         // post-process source resolution
uint   _DstWidth;         // post-process destination resolution
uint   _Offset;           // first element handled by this dispatch
uint   _End;              // one past the last element handled by this dispatch

float3 _GridOrigin;
float  _InvCellSize;
uint   _HashMask;
float  _SampleSearchNorm; // (_Radius * _InvCellSize + eps)^2 for cell-sphere AABB culling

float3 _EdgeGridOrigin;
float  _EdgeInvCellSize;
uint   _EdgeHashMask;
float  _EdgeSearchNorm;   // (edgeMaxReach * _EdgeInvCellSize + eps)^2 for cell-sphere AABB culling
uint   _EdgeCount;        // 0 = no edges bound

float  _Radius;
float  _Strength;
float  _NormalRejection;
float  _GeometryWeight;   // 0 = shading normals estimator, 1 = geometry estimator (face normals)
uint   _SameComponentOnly;
float  _EdgeWidth;
float  _EdgeStrength;
uint   _UseBevelCore;     // 1 = combine edge term with _TriangleBevelCore (SharpConvex mode)

uint   _JfaStep;
uint   _DilationDist2;

static const uint  NoOwner            = 0xFFFFFFFFu;
static const uint  NoSeed             = 0xFFFFFFFFu;
static const float ConservativeRadius = 0.75; // pixels (UvLayout.ConservativeRadius)
static const float RejectionBand      = 0.25; // normal-dot range over which rejection fades in
static const float EdgeFacingMin      = 0.3;  // texel normal vs. edge face normal: fade-in range
static const float EdgeFacingMax      = 0.6;
static const float EdgePlaneMin       = 0.65; // coplanarity fade-out to block parallel stacked plates
static const float EdgePlaneMax       = 0.92;

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
float Cross2(float2 a, float2 b)
{
    return a.x * b.y - a.y * b.x;
}

float3 SafeNormalize(float3 v, float3 fallback)
{
    float len2 = dot(v, v);
    return len2 > 1e-30 ? v * rsqrt(len2) : fallback;
}

uint EncodeNormal(float3 n)
{
    n /= max(abs(n.x) + abs(n.y) + abs(n.z), 1e-20);
    float2 e = n.xy;
    if (n.z < 0.0)
    {
        float2 s = float2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
        e = (1.0 - abs(n.yx)) * s;
    }
    uint2 q = (uint2)round(saturate(e * 0.5 + 0.5) * 65535.0);
    return q.x | (q.y << 16);
}

float3 DecodeNormal(uint v)
{
    float2 e = float2(v & 0xFFFFu, v >> 16) / 65535.0 * 2.0 - 1.0;
    float3 n = float3(e, 1.0 - abs(e.x) - abs(e.y));
    float t = saturate(-n.z);
    n.x += n.x >= 0.0 ? -t : t;
    n.y += n.y >= 0.0 ? -t : t;
    return SafeNormalize(n, float3(0, 0, 1));
}

// Exact open-addressing lookup for one 3D grid cell (load factor <= 0.5).
// Eliminates both distant-cell collisions and the 351-check deduplication loop.
uint2 LookupCell(StructuredBuffer<CellEntry> table, uint mask, int3 c)
{
    if (c.x < 0 || c.y < 0 || c.z < 0)
        return uint2(0, 0);

    uint cx = (uint)c.x;
    uint cy = (uint)c.y;
    uint cz = (uint)c.z;
    uint keyLo = (cx & 0x1FFFFFu) | ((cy & 0x7FFu) << 21);
    uint keyHi = ((cy >> 11) & 0x3FFu) | ((cz & 0x1FFFFFu) << 10);
    uint slot  = ((cx * 73856093u) ^ (cy * 19349663u) ^ (cz * 83492791u)) & mask;

    [loop]
    for (uint probe = 0; probe <= mask; probe++)
    {
        CellEntry e = table[slot];
        if (e.count == 0)
            return uint2(0, 0);
        if (e.keyLo == keyLo && e.keyHi == keyHi)
            return uint2(e.start, e.count);
        slot = (slot + 1u) & mask;
    }
    return uint2(0, 0);
}

bool LoadTriangle(uint t, out uint i0, out uint i1, out uint i2, out float2 a, out float2 b, out float2 c)
{
    i0 = _Triangles[t * 3 + 0];
    i1 = _Triangles[t * 3 + 1];
    i2 = _Triangles[t * 3 + 2];
    // Pixel space: texel centres land on integer coordinates.
    a = _UVs[i0] * _Width - 0.5;
    b = _UVs[i1] * _Width - 0.5;
    c = _UVs[i2] * _Width - 0.5;
    return abs(Cross2(b - a, c - a)) > 1e-10;
}

// Loads the triangle of a raster tile and the pixel range of the tile within
// `margin` pixels of the triangle's bounding box.
bool LoadTile(uint item, float margin, out uint t, out float2 a, out float2 b, out float2 c,
              out int2 lo, out int2 hi)
{
    uint2 tile = _RasterTiles[item];
    t = tile.x;
    uint i0, i1, i2;
    bool valid = LoadTriangle(t, i0, i1, i2, a, b, c);

    // Clamp in float before converting so far-away UVs cannot overflow the int conversion.
    float2 tileLo = float2(tile.y & 0xFFFFu, tile.y >> 16) * _TileSize;
    float2 tileHi = min(tileLo + (_TileSize - 1), (float)(_Width - 1));
    lo = (int2)ceil(max(min(a, min(b, c)) - margin, tileLo));
    hi = (int2)floor(min(max(a, max(b, c)) + margin, tileHi));
    return valid;
}

float3 Barycentric(float2 p, float2 a, float2 b, float2 c)
{
    float invArea = 1.0 / Cross2(b - a, c - a);
    float w0 = Cross2(b - p, c - p) * invArea;
    float w1 = Cross2(c - p, a - p) * invArea;
    return float3(w0, w1, 1.0 - w0 - w1);
}

bool Inside(float3 w)
{
    return min(w.x, min(w.y, w.z)) >= -1e-5;
}

void ClosestOnSegment(float2 p, float2 s0, float2 s1, out float t, out float dist2)
{
    float2 e = s1 - s0;
    float len2 = dot(e, e);
    t = len2 > 1e-12 ? saturate(dot(p - s0, e) / len2) : 0.0;
    float2 d = p - (s0 + e * t);
    dist2 = dot(d, d);
}

// Closest point on the triangle's border: barycentrics and squared pixel distance.
// `precise` keeps both conservative passes bit-identical, which the owner pass relies on.
float3 ClosestOnBorder(float2 p, float2 a, float2 b, float2 c, out precise float dist2)
{
    precise float tab, tbc, tca, dab, dbc, dca;
    ClosestOnSegment(p, a, b, tab, dab);
    ClosestOnSegment(p, b, c, tbc, dbc);
    ClosestOnSegment(p, c, a, tca, dca);

    if (dab <= dbc && dab <= dca) { dist2 = dab; return float3(1.0 - tab, tab, 0.0); }
    if (dbc <= dca)               { dist2 = dbc; return float3(0.0, 1.0 - tbc, tbc); }
    dist2 = dca;
    return float3(tca, 0.0, 1.0 - tca);
}

// Geometric normal oriented to agree with the shading normals (SurfaceMesh.FaceNormal).
float3 FaceNormal(uint i0, uint i1, uint i2)
{
    float3 p0 = _Positions[i0];
    float3 shading = _Normals[i0] + _Normals[i1] + _Normals[i2];
    float3 n = SafeNormalize(cross(_Positions[i1] - p0, _Positions[i2] - p0), SafeNormalize(shading, float3(0, 0, 1)));
    return dot(n, shading) < 0.0 ? -n : n;
}

// ---------------------------------------------------------------------------
// ClearGBuffer — 1 thread per texel in [_Offset, _End)
// ---------------------------------------------------------------------------
[numthreads(64, 1, 1)]
void ClearGBuffer(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x + _Offset;
    if (index >= _End) return;
    _GOwner[index] = NoOwner;
    _GDist[index]  = NoOwner;
}

// ---------------------------------------------------------------------------
// Rasterization — 1 thread per raster tile in [_Offset, _End), so the work per
// thread is bounded by the tile size however large the triangle is.
// ---------------------------------------------------------------------------
[numthreads(64, 1, 1)]
void RasterInterior(uint3 id : SV_DispatchThreadID)
{
    uint item = id.x + _Offset;
    if (item >= _End) return;

    uint t;
    float2 a, b, c;
    int2 lo, hi;
    if (!LoadTile(item, 0.0, t, a, b, c, lo, hi)) return;
    if (lo.x > hi.x || lo.y > hi.y) return;

    // Incremental barycentric stepping avoids per-pixel divisions and cross products.
    float invArea = 1.0 / Cross2(b - a, c - a);
    float dw0x = (b.y - c.y) * invArea;
    float dw0y = (c.x - b.x) * invArea;
    float dw1x = (c.y - a.y) * invArea;
    float dw1y = (a.x - c.x) * invArea;

    float2 p0 = float2(lo);
    float w0Row = Cross2(b - p0, c - p0) * invArea;
    float w1Row = Cross2(c - p0, a - p0) * invArea;

    for (int y = lo.y; y <= hi.y; y++)
    {
        float w0 = w0Row;
        float w1 = w1Row;
        uint rowBase = (uint)y * _Width;
        for (int x = lo.x; x <= hi.x; x++)
        {
            if (w0 >= -1e-5 && w1 >= -1e-5 && (1.0 - w0 - w1) >= -1e-5)
            {
                uint previous;
                InterlockedMin(_GOwner[rowBase + (uint)x], t, previous);
            }
            w0 += dw0x;
            w1 += dw1x;
        }
        w0Row += dw0y;
        w1Row += dw1y;
    }
}

[numthreads(64, 1, 1)]
void RasterConservativeDistance(uint3 id : SV_DispatchThreadID)
{
    uint item = id.x + _Offset;
    if (item >= _End) return;

    uint t;
    float2 a, b, c;
    int2 lo, hi;
    if (!LoadTile(item, ConservativeRadius, t, a, b, c, lo, hi)) return;
    const float maxDist2 = ConservativeRadius * ConservativeRadius;

    for (int y = lo.y; y <= hi.y; y++)
    {
        uint rowBase = (uint)y * _Width;
        for (int x = lo.x; x <= hi.x; x++)
        {
            uint index = rowBase + (uint)x;
            if (_GOwner[index] != NoOwner) continue;

            precise float dist2;
            ClosestOnBorder(float2(x, y), a, b, c, dist2);
            if (dist2 > maxDist2) continue;
            uint previous;
            InterlockedMin(_GDist[index], asuint(dist2), previous); // non-negative floats order like uints
        }
    }
}

[numthreads(64, 1, 1)]
void RasterConservativeOwner(uint3 id : SV_DispatchThreadID)
{
    uint item = id.x + _Offset;
    if (item >= _End) return;

    uint t;
    float2 a, b, c;
    int2 lo, hi;
    if (!LoadTile(item, ConservativeRadius, t, a, b, c, lo, hi)) return;

    for (int y = lo.y; y <= hi.y; y++)
    {
        uint rowBase = (uint)y * _Width;
        for (int x = lo.x; x <= hi.x; x++)
        {
            // Only texels the previous pass touched (interior texels keep NoOwner here).
            uint index = rowBase + (uint)x;
            uint best = _GDist[index];
            if (best == NoOwner) continue;

            precise float dist2;
            ClosestOnBorder(float2(x, y), a, b, c, dist2);
            if (asuint(dist2) > best) continue;
            uint previous;
            InterlockedMin(_GOwner[index], t, previous);
        }
    }
}

// ---------------------------------------------------------------------------
// ResolveGBuffer — 1 thread per texel in [_Offset, _End). Writes the owner's
// attributes: interpolated inside the triangle, else at its closest border point.
// ---------------------------------------------------------------------------
[numthreads(64, 1, 1)]
void ResolveGBuffer(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x + _Offset;
    if (index >= _End) return;

    uint t = _GOwner[index];
    if (t == NoOwner)
    {
        _GPosition[index] = float4(0, 0, 0, 0);
        _GNormal[index]   = 0;
        return;
    }

    uint i0, i1, i2;
    float2 a, b, c;
    LoadTriangle(t, i0, i1, i2, a, b, c);

    float2 p = float2(index % _Width, index / _Width);
    float3 w = Barycentric(p, a, b, c);
    if (!Inside(w))
    {
        float dist2;
        w = ClosestOnBorder(p, a, b, c, dist2);
    }

    float3 position = w.x * _Positions[i0] + w.y * _Positions[i1] + w.z * _Positions[i2];
    float3 normal   = _GeometryWeight > 0.5
                    ? FaceNormal(i0, i1, i2)
                    : SafeNormalize(w.x * _Normals[i0] + w.y * _Normals[i1] + w.z * _Normals[i2], _Normals[i0]);
    _GPosition[index] = float4(position, (float)(_Patches[i0] + 1));
    _GNormal[index]   = EncodeNormal(normal);
}

// ---------------------------------------------------------------------------
// EvaluateCurvature — 1 thread per texel, mapped in 8x8 UV blocks so threads
// in a warp/wavefront query the same 3D hash cells and share L1/L2 cache.
//
// 1) Smooth term (width = _Radius):
//    Shading normals: H = sum(w * dot(n_i - n_avg, d_i)) / sum(w * |d_i|^2)
//    Geometry:        H = 2 * sum(w * dot(np, p - q_i)) / sum(w * |q_i - p|^2)
//                     Exact (H = 1/R) on closed AND open spheres/cylinders and
//                     0 on open flat planes without boundary attenuation.
//
// 2) Edge term (width = _EdgeWidth):
//    Strongest nearby hard/sharp convex edge bordering the texel's patch,
//    filtered by both normal facing and face coplanarity so edges do not bleed
//    onto nearby parallel stacked sheets.
// ---------------------------------------------------------------------------
float SmoothCurvature(float3 p, float3 np, uint patchId, uint component)
{
    float  r2      = _Radius * _Radius;
    float  invR2   = 1.0 / r2;
    float3 rel     = (p - _GridOrigin) * _InvCellSize;
    int3   cell    = (int3)floor(rel);
    float3 f       = rel - (float3)cell;
    bool   useGeom = _GeometryWeight > 0.5;

    float  sumW  = 0.0;
    float3 sumD  = float3(0, 0, 0);
    float3 sumN  = float3(0, 0, 0);
    float  sumND = 0.0;
    float  sumD2 = 0.0;

    [loop]
    for (int dz = -1; dz <= 1; dz++)
    {
        float ez = dz < 0 ? f.z : (dz > 0 ? 1.0 - f.z : 0.0);
        float ez2 = ez * ez;
        if (ez2 > _SampleSearchNorm) continue;

        [loop]
        for (int dy = -1; dy <= 1; dy++)
        {
            float ey = dy < 0 ? f.y : (dy > 0 ? 1.0 - f.y : 0.0);
            float eyz2 = ez2 + ey * ey;
            if (eyz2 > _SampleSearchNorm) continue;

            [loop]
            for (int dx = -1; dx <= 1; dx++)
            {
                float ex = dx < 0 ? f.x : (dx > 0 ? 1.0 - f.x : 0.0);
                if (eyz2 + ex * ex > _SampleSearchNorm) continue;

                uint2 range = LookupCell(_SampleCells, _HashMask, cell + int3(dx, dy, dz));
                uint end = range.x + range.y;
                [loop]
                for (uint s = range.x; s < end; s++)
                {
                    SurfaceSample smp = _Samples[s];
                    float3 d  = smp.position - p;
                    float  d2 = dot(d, d);
                    if (d2 >= r2) continue;

                    if (smp.patchId != patchId)
                    {
                        uint sampleComponent = _PatchComponents[smp.patchId];
                        if (sampleComponent == component) continue; // across a hard edge
                        if (_SameComponentOnly != 0) continue;       // another mesh part
                    }

                    float3 sn = DecodeNormal(smp.normalOct);
                    float facing = smoothstep(_NormalRejection, _NormalRejection + RejectionBand, dot(sn, np));
                    if (facing <= 0.0) continue;

                    float k = 1.0 - d2 * invR2;
                    float w = smp.weight * k * k * facing;

                    sumW  += w;
                    sumD  += w * d;
                    sumD2 += w * d2;
                    if (!useGeom)
                    {
                        sumN  += w * sn;
                        sumND += w * dot(sn, d);
                    }
                }
            }
        }
    }

    if (sumD2 <= 1e-10 * sumW * r2)
        return 0.0;

    if (useGeom)
        return -2.0 * dot(np, sumD) / sumD2 * _Radius;

    float3 nAvg = SafeNormalize(sumN, np);
    return (sumND - dot(nAvg, sumD)) / sumD2 * _Radius;
}

float EdgeCurvature(float3 p, float3 np, uint patchId)
{
    if (_EdgeCount == 0)
        return 0.0;

    float  w2    = _EdgeWidth * _EdgeWidth;
    float  invW2 = 1.0 / w2;
    float3 rel   = (p - _EdgeGridOrigin) * _EdgeInvCellSize;
    int3   cell  = (int3)floor(rel);
    float3 f     = rel - (float3)cell;
    float  best  = 0.0;

    [loop]
    for (int dz = -1; dz <= 1; dz++)
    {
        float ez = dz < 0 ? f.z : (dz > 0 ? 1.0 - f.z : 0.0);
        float ez2 = ez * ez;
        if (ez2 > _EdgeSearchNorm) continue;

        [loop]
        for (int dy = -1; dy <= 1; dy++)
        {
            float ey = dy < 0 ? f.y : (dy > 0 ? 1.0 - f.y : 0.0);
            float eyz2 = ez2 + ey * ey;
            if (eyz2 > _EdgeSearchNorm) continue;

            [loop]
            for (int dx = -1; dx <= 1; dx++)
            {
                float ex = dx < 0 ? f.x : (dx > 0 ? 1.0 - f.x : 0.0);
                if (eyz2 + ex * ex > _EdgeSearchNorm) continue;

                uint2 range = LookupCell(_EdgeCells, _EdgeHashMask, cell + int3(dx, dy, dz));
                uint end = range.x + range.y;
                [loop]
                for (uint s = range.x; s < end; s++)
                {
                    EdgeSegment edge = _Edges[s];
                    if (edge.patchA != patchId && edge.patchB != patchId) continue;

                    float3 ab = edge.b - edge.a;
                    float  t  = saturate(dot(p - edge.a, ab) / max(dot(ab, ab), 1e-20));
                    float3 c  = edge.a + ab * t - p;
                    float  d2 = dot(c, c);
                    if (d2 >= w2) continue;

                    // Require the texel to both face one of the edge's adjacent faces AND lie near
                    // that face's plane (blocks bleed-through onto back sides and parallel stacked sheets).
                    float  dist   = sqrt(d2);
                    float3 vDir   = dist > 1e-6 ? (-c / dist) : float3(0, 0, 0);
                    float  matchA = smoothstep(EdgeFacingMin, EdgeFacingMax, dot(np, edge.faceNormalA))
                                  * (1.0 - smoothstep(EdgePlaneMin, EdgePlaneMax, abs(dot(vDir, edge.faceNormalA))));
                    float  matchB = smoothstep(EdgeFacingMin, EdgeFacingMax, dot(np, edge.faceNormalB))
                                  * (1.0 - smoothstep(EdgePlaneMin, EdgePlaneMax, abs(dot(vDir, edge.faceNormalB))));
                    float  facing = max(matchA, matchB);
                    if (facing <= 0.0) continue;

                    float k = 1.0 - d2 * invW2;
                    float v = edge.value * k * k * facing;
                    if (abs(v) > abs(best)) best = v;
                }
            }
        }
    }
    return best;
}

[numthreads(64, 1, 1)]
void EvaluateCurvature(uint3 id : SV_DispatchThreadID)
{
    uint dispatchIdx = id.x + _Offset;
    if (dispatchIdx >= _End) return;

    // 8x8 UV-block mapping: 64-thread groups process tight 2D squares for 3D spatial cache locality.
    uint blockIdx     = dispatchIdx >> 6;
    uint localIdx     = dispatchIdx & 63u;
    uint blocksPerRow = _Width >> 3;
    uint x            = ((blockIdx % blocksPerRow) << 3) | (localIdx & 7u);
    uint y            = ((blockIdx / blocksPerRow) << 3) | (localIdx >> 3);
    uint index        = y * _Width + x;

    float4 g = _GPosition[index];
    if (g.w < 0.5)
    {
        _Result[index] = float2(0, 0);
        return;
    }

    float3 p         = g.xyz;
    uint   patchId   = (uint)(g.w + 0.5) - 1;
    uint   component = _PatchComponents[patchId];
    float3 np        = DecodeNormal(_GNormal[index]);
    uint   ownerTri  = _GOwner[index];

    float value = 0.0;
    if (_Strength > 0.0)
        value += _Strength * SmoothCurvature(p, np, patchId, component);
    if (_EdgeStrength > 0.0)
    {
        float edgeVal = EdgeCurvature(p, np, patchId);
        if (_UseBevelCore != 0)
            edgeVal = max(edgeVal, _TriangleBevelCore[ownerTri]);
        value += _EdgeStrength * edgeVal;
    }
    _Result[index] = float2(value, (float)(_TriangleIslands[ownerTri] + 1));
}

// ---------------------------------------------------------------------------
// Downsample — 2x2 average of valid texels of the dominant UV island.
// ---------------------------------------------------------------------------
float2 DominantIslandAverage4(float2 s[4])
{
    float island = 0.0;
    uint  best   = 0;
    [unroll]
    for (uint i = 0; i < 4; i++)
    {
        if (s[i].y < 0.5) continue;
        uint count = 0;
        [unroll]
        for (uint j = 0; j < 4; j++)
            count += s[j].y == s[i].y ? 1u : 0u;
        if (count > best || (count == best && s[i].y < island))
        {
            best   = count;
            island = s[i].y;
        }
    }
    if (best == 0)
        return float2(0.0, 0.0);

    float sum = 0.0;
    [unroll]
    for (uint k = 0; k < 4; k++)
        sum += s[k].y == island ? s[k].x : 0.0;
    return float2(sum / best, island);
}

[numthreads(64, 1, 1)]
void Downsample(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x + _Offset;
    if (index >= _End) return;

    uint x = index % _DstWidth;
    uint y = index / _DstWidth;

    float2 s[4];
    s[0] = _Src[(y * 2 + 0) * _SrcWidth + (x * 2 + 0)];
    s[1] = _Src[(y * 2 + 0) * _SrcWidth + (x * 2 + 1)];
    s[2] = _Src[(y * 2 + 1) * _SrcWidth + (x * 2 + 0)];
    s[3] = _Src[(y * 2 + 1) * _SrcWidth + (x * 2 + 1)];

    _Dst[index] = DominantIslandAverage4(s);
}

// ---------------------------------------------------------------------------
// Blur — 3x3 Gaussian over valid texels of the same island. Empty texels stay empty.
// ---------------------------------------------------------------------------
[numthreads(64, 1, 1)]
void Blur(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x + _Offset;
    if (index >= _End) return;

    float2 center = _Src[index];
    if (center.y < 0.5)
    {
        _Dst[index] = center;
        return;
    }

    int x = (int)(index % _SrcWidth);
    int y = (int)(index / _SrcWidth);
    int w = (int)_SrcWidth;

    float sum = 0.0;
    float weight = 0.0;
    [unroll]
    for (int oy = -1; oy <= 1; oy++)
    {
        int sy = y + oy;
        if (sy < 0 || sy >= w) continue;
        [unroll]
        for (int ox = -1; ox <= 1; ox++)
        {
            int sx = x + ox;
            if (sx < 0 || sx >= w) continue;
            float2 s = _Src[(uint)sy * (uint)w + (uint)sx];
            if (s.y != center.y) continue;
            float k = (ox == 0 ? 2.0 : 1.0) * (oy == 0 ? 2.0 : 1.0);
            sum    += s.x * k;
            weight += k;
        }
    }

    _Dst[index] = float2(sum / weight, center.y);
}

// ---------------------------------------------------------------------------
// Jump Flooding Algorithm (JFA) Dilation — O(log N) Euclidean nearest-texel
// dilation. Never mixes across UV islands and preserves crisp edges without
// iterative blurring.
// ---------------------------------------------------------------------------
[numthreads(64, 1, 1)]
void JfaInit(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x + _Offset;
    if (index >= _End) return;

    if (_Src[index].y > 0.5)
    {
        uint x = index % _SrcWidth;
        uint y = index / _SrcWidth;
        _JfaDst[index] = (x & 0xFFFFu) | ((y & 0xFFFFu) << 16);
    }
    else
    {
        _JfaDst[index] = NoSeed;
    }
}

[numthreads(64, 1, 1)]
void JfaStep(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x + _Offset;
    if (index >= _End) return;

    int x = (int)(index % _SrcWidth);
    int y = (int)(index / _SrcWidth);
    int w = (int)_SrcWidth;
    int step = (int)_JfaStep;

    uint bestSeed = _JfaSrc[index];
    uint bestDist2 = 0xFFFFFFFFu;
    if (bestSeed != NoSeed)
    {
        int dx = (int)(bestSeed & 0xFFFFu) - x;
        int dy = (int)(bestSeed >> 16) - y;
        bestDist2 = (uint)(dx * dx + dy * dy);
    }

    [unroll]
    for (int oy = -1; oy <= 1; oy++)
    {
        int ny = y + oy * step;
        if (ny < 0 || ny >= w) continue;
        [unroll]
        for (int ox = -1; ox <= 1; ox++)
        {
            if (ox == 0 && oy == 0) continue;
            int nx = x + ox * step;
            if (nx < 0 || nx >= w) continue;

            uint cand = _JfaSrc[(uint)ny * (uint)w + (uint)nx];
            if (cand == NoSeed) continue;

            int dx = (int)(cand & 0xFFFFu) - x;
            int dy = (int)(cand >> 16) - y;
            uint d2 = (uint)(dx * dx + dy * dy);
            if (d2 < bestDist2 || (d2 == bestDist2 && cand < bestSeed))
            {
                bestDist2 = d2;
                bestSeed = cand;
            }
        }
    }

    _JfaDst[index] = bestSeed;
}

[numthreads(64, 1, 1)]
void JfaApply(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x + _Offset;
    if (index >= _End) return;

    float2 center = _Src[index];
    if (center.y > 0.5)
    {
        _Dst[index] = center;
        return;
    }

    uint seed = _JfaSrc[index];
    if (seed != NoSeed)
    {
        int x = (int)(index % _SrcWidth);
        int y = (int)(index / _SrcWidth);
        int sx = (int)(seed & 0xFFFFu);
        int sy = (int)(seed >> 16);
        int dx = sx - x;
        int dy = sy - y;
        if ((uint)(dx * dx + dy * dy) <= _DilationDist2)
        {
            _Dst[index] = _Src[(uint)sy * _SrcWidth + (uint)sx];
            return;
        }
    }

    _Dst[index] = float2(0.0, 0.0);
}
