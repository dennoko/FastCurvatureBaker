#pragma kernel ClearGBuffer
#pragma kernel RasterInterior
#pragma kernel RasterConservativeDistance
#pragma kernel RasterConservativeOwner
#pragma kernel ResolveGBuffer
#pragma kernel EvaluateCurvature
#pragma kernel Downsample
#pragma kernel Blur
#pragma kernel Dilate

// All 2D images are StructuredBuffers indexed as y * width + x.
// Texel (x, y) covers UV ((x + 0.5) / width, (y + 0.5) / width); y = 0 is v = 0.

// ---------------------------------------------------------------------------
// Mesh (world space)
// ---------------------------------------------------------------------------
StructuredBuffer<float3> _Positions;
StructuredBuffer<float3> _Normals;
StructuredBuffer<float2> _UVs;
StructuredBuffer<uint>   _Patches;          // smooth-patch id per vertex
StructuredBuffer<uint>   _PatchComponents;  // connected-part id per patch
StructuredBuffer<uint>   _Triangles;
StructuredBuffer<uint2>  _RasterTiles;      // (triangle, tileX | tileY << 16), see UvLayout.cs

// ---------------------------------------------------------------------------
// G-buffer
//   _GOwner:    triangle owning the texel (NoOwner = empty). Chosen with atomics
//               so the result does not depend on thread scheduling.
//   _GDist:     conservative pass scratch: smallest distance² (as uint) of a
//               candidate triangle. Shares its buffer with _GNormal.
//   _GPosition: xyz = world position, w = patch id + 1 (0 = empty texel)
//   _GNormal:   octahedral-encoded normal (16 + 16 bit)
// ---------------------------------------------------------------------------
RWStructuredBuffer<uint>   _GOwner;
RWStructuredBuffer<uint>   _GDist;
RWStructuredBuffer<float4> _GPosition;
RWStructuredBuffer<uint>   _GNormal;

// ---------------------------------------------------------------------------
// Surface samples in a hashed grid (see SpatialHashGrid.cs)
// ---------------------------------------------------------------------------
struct SurfaceSample
{
    float3 position;
    float3 normal;
    uint   patchId;
    float  weight;
};
StructuredBuffer<SurfaceSample> _Samples;
StructuredBuffer<uint2>         _Buckets; // (start, count)

// ---------------------------------------------------------------------------
// Hard-edge segments in a second hashed grid (see HardEdgeSegments.cs)
// ---------------------------------------------------------------------------
struct EdgeSegment
{
    float3 a;
    float3 b;
    float3 faceNormalA;
    float3 faceNormalB;
    float  value;      // +1 = 90-degree convex, -1 = 90-degree concave
    uint   component;
};
StructuredBuffer<EdgeSegment> _Edges;
StructuredBuffer<uint2>       _EdgeBuckets;

// ---------------------------------------------------------------------------
// Images: x = curvature value, y = coverage (1 = valid, 0 = empty)
// ---------------------------------------------------------------------------
RWStructuredBuffer<float2> _Result;
StructuredBuffer<float2>   _Src;
RWStructuredBuffer<float2> _Dst;

// ---------------------------------------------------------------------------
// Parameters
// ---------------------------------------------------------------------------
uint   _Width;          // G-buffer / evaluation resolution
uint   _TileSize;       // raster tile edge in pixels
uint   _SrcWidth;       // post-process source resolution
uint   _DstWidth;       // post-process destination resolution
uint   _Offset;         // first element handled by this dispatch
uint   _End;            // one past the last element handled by this dispatch

float3 _GridOrigin;
float  _InvCellSize;
uint   _HashMask;

float3 _EdgeGridOrigin;
float  _EdgeInvCellSize;
uint   _EdgeHashMask;
uint   _EdgeCount;      // 0 = no hard edges bound

float  _Radius;
float  _Strength;
float  _NormalRejection;
float  _GeometryWeight; // 0 = shading normals estimator, 1 = geometry estimator
uint   _SameComponentOnly;
float  _EdgeWidth;
float  _EdgeStrength;

static const uint  NoOwner            = 0xFFFFFFFF;
static const float ConservativeRadius = 0.75; // pixels (UvLayout.ConservativeRadius)
static const float RejectionBand      = 0.25; // normal-dot range over which rejection fades in
static const float EdgeFacingMin      = 0.3;  // texel normal vs. edge face normal: fade-in range
static const float EdgeFacingMax      = 0.6;

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
float Cross2(float2 a, float2 b)
{
    return a.x * b.y - a.y * b.x;
}

float3 SafeNormalize(float3 v, float3 fallback)
{
    float len2 = dot(v, v);
    return len2 > 1e-30 ? v * rsqrt(len2) : fallback;
}

uint EncodeNormal(float3 n)
{
    n /= max(abs(n.x) + abs(n.y) + abs(n.z), 1e-20);
    float2 e = n.xy;
    if (n.z < 0.0)
    {
        float2 s = float2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
        e = (1.0 - abs(n.yx)) * s;
    }
    uint2 q = (uint2)round(saturate(e * 0.5 + 0.5) * 65535.0);
    return q.x | (q.y << 16);
}

float3 DecodeNormal(uint v)
{
    float2 e = float2(v & 0xFFFF, v >> 16) / 65535.0 * 2.0 - 1.0;
    float3 n = float3(e, 1.0 - abs(e.x) - abs(e.y));
    float t = saturate(-n.z);
    n.x += n.x >= 0.0 ? -t : t;
    n.y += n.y >= 0.0 ? -t : t;
    return SafeNormalize(n, float3(0, 0, 1));
}

uint HashCell(int3 c)
{
    uint3 u = (uint3)c;
    return (u.x * 73856093u) ^ (u.y * 19349663u) ^ (u.z * 83492791u);
}

int3 NeighbourOffset(uint i)
{
    return int3(uint3(i % 3u, (i / 3u) % 3u, i / 9u)) - 1;
}

// Bucket of the i-th cell of the 3x3x3 neighbourhood, or 0xFFFFFFFF when an earlier cell
// already hashed to the same bucket (distinct cells may collide; visit each bucket once).
// Recomputing earlier hashes keeps this in registers (no indexable array).
uint NeighbourBucket(int3 cell, uint i, uint mask)
{
    uint bucket = HashCell(cell + NeighbourOffset(i)) & mask;
    [unroll(27)]
    for (uint j = 0; j < i; j++)
    {
        if ((HashCell(cell + NeighbourOffset(j)) & mask) == bucket)
            return 0xFFFFFFFF;
    }
    return bucket;
}

bool LoadTriangle(uint t, out uint i0, out uint i1, out uint i2, out float2 a, out float2 b, out float2 c)
{
    i0 = _Triangles[t * 3 + 0];
    i1 = _Triangles[t * 3 + 1];
    i2 = _Triangles[t * 3 + 2];
    // Pixel space: texel centres land on integer coordinates.
    a = _UVs[i0] * _Width - 0.5;
    b = _UVs[i1] * _Width - 0.5;
    c = _UVs[i2] * _Width - 0.5;
    return abs(Cross2(b - a, c - a)) > 1e-10;
}

// Loads the triangle of a raster tile and the pixel range of the tile within
// `margin` pixels of the triangle's bounding box.
bool LoadTile(uint item, float margin, out uint t, out float2 a, out float2 b, out float2 c,
              out int2 lo, out int2 hi)
{
    uint2 tile = _RasterTiles[item];
    t = tile.x;
    uint i0, i1, i2;
    bool valid = LoadTriangle(t, i0, i1, i2, a, b, c);

    int2 tileLo = int2(tile.y & 0xFFFF, tile.y >> 16) * (int)_TileSize;
    lo = max(max((int2)ceil(min(a, min(b, c)) - margin), tileLo), int2(0, 0));
    hi = min(min((int2)floor(max(a, max(b, c)) + margin), tileLo + (int)_TileSize - 1), (int)_Width - 1);
    return valid;
}

float3 Barycentric(float2 p, float2 a, float2 b, float2 c)
{
    float invArea = 1.0 / Cross2(b - a, c - a);
    float w0 = Cross2(b - p, c - p) * invArea;
    float w1 = Cross2(c - p, a - p) * invArea;
    return float3(w0, w1, 1.0 - w0 - w1);
}

bool Inside(float3 w)
{
    return min(w.x, min(w.y, w.z)) >= -1e-5;
}

void ClosestOnSegment(float2 p, float2 s0, float2 s1, out float t, out float dist2)
{
    float2 e = s1 - s0;
    float len2 = dot(e, e);
    t = len2 > 1e-12 ? saturate(dot(p - s0, e) / len2) : 0.0;
    float2 d = p - (s0 + e * t);
    dist2 = dot(d, d);
}

// Closest point on the triangle's border: barycentrics and squared pixel distance.
// `precise` keeps both conservative passes bit-identical, which the owner pass relies on.
float3 ClosestOnBorder(float2 p, float2 a, float2 b, float2 c, out precise float dist2)
{
    precise float tab, tbc, tca, dab, dbc, dca;
    ClosestOnSegment(p, a, b, tab, dab);
    ClosestOnSegment(p, b, c, tbc, dbc);
    ClosestOnSegment(p, c, a, tca, dca);

    if (dab <= dbc && dab <= dca) { dist2 = dab; return float3(1.0 - tab, tab, 0.0); }
    if (dbc <= dca)               { dist2 = dbc; return float3(0.0, 1.0 - tbc, tbc); }
    dist2 = dca;
    return float3(tca, 0.0, 1.0 - tca);
}

// ---------------------------------------------------------------------------
// ClearGBuffer — 1 thread per texel in [_Offset, _End)
// ---------------------------------------------------------------------------
[numthreads(64, 1, 1)]
void ClearGBuffer(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x + _Offset;
    if (index >= _End) return;
    _GOwner[index] = NoOwner;
    _GDist[index]  = NoOwner;
}

// ---------------------------------------------------------------------------
// Rasterization — 1 thread per raster tile in [_Offset, _End), so the work per
// thread is bounded by the tile size however large the triangle is.
// Ownership is decided with atomics in three passes; attributes are written
// once afterwards by ResolveGBuffer, so position, patch and normal of a texel
// always come from the same triangle and repeated bakes are identical.
//
// 1) RasterInterior: texels whose centre lies inside a triangle. Overlapping
//    UVs resolve to the lowest triangle index.
// 2) RasterConservativeDistance: texels still empty record the smallest
//    distance to any triangle within ConservativeRadius (fills island borders
//    without bleeding into texels another island covers).
// 3) RasterConservativeOwner: among the triangles at that distance, the lowest
//    index wins.
// ---------------------------------------------------------------------------
[numthreads(64, 1, 1)]
void RasterInterior(uint3 id : SV_DispatchThreadID)
{
    uint item = id.x + _Offset;
    if (item >= _End) return;

    uint t;
    float2 a, b, c;
    int2 lo, hi;
    if (!LoadTile(item, 0.0, t, a, b, c, lo, hi)) return;

    for (int y = lo.y; y <= hi.y; y++)
    {
        for (int x = lo.x; x <= hi.x; x++)
        {
            if (!Inside(Barycentric(float2(x, y), a, b, c))) continue;
            uint previous;
            InterlockedMin(_GOwner[(uint)y * _Width + (uint)x], t, previous);
        }
    }
}

[numthreads(64, 1, 1)]
void RasterConservativeDistance(uint3 id : SV_DispatchThreadID)
{
    uint item = id.x + _Offset;
    if (item >= _End) return;

    uint t;
    float2 a, b, c;
    int2 lo, hi;
    if (!LoadTile(item, ConservativeRadius, t, a, b, c, lo, hi)) return;
    const float maxDist2 = ConservativeRadius * ConservativeRadius;

    for (int y = lo.y; y <= hi.y; y++)
    {
        for (int x = lo.x; x <= hi.x; x++)
        {
            uint index = (uint)y * _Width + (uint)x;
            if (_GOwner[index] != NoOwner) continue;

            precise float dist2;
            ClosestOnBorder(float2(x, y), a, b, c, dist2);
            if (dist2 > maxDist2) continue;
            uint previous;
            InterlockedMin(_GDist[index], asuint(dist2), previous); // non-negative floats order like uints
        }
    }
}

[numthreads(64, 1, 1)]
void RasterConservativeOwner(uint3 id : SV_DispatchThreadID)
{
    uint item = id.x + _Offset;
    if (item >= _End) return;

    uint t;
    float2 a, b, c;
    int2 lo, hi;
    if (!LoadTile(item, ConservativeRadius, t, a, b, c, lo, hi)) return;

    for (int y = lo.y; y <= hi.y; y++)
    {
        for (int x = lo.x; x <= hi.x; x++)
        {
            // Only texels the previous pass touched (interior texels keep NoOwner here).
            uint index = (uint)y * _Width + (uint)x;
            uint best = _GDist[index];
            if (best == NoOwner) continue;

            precise float dist2;
            ClosestOnBorder(float2(x, y), a, b, c, dist2);
            if (asuint(dist2) > best) continue;
            uint previous;
            InterlockedMin(_GOwner[index], t, previous);
        }
    }
}

// ---------------------------------------------------------------------------
// ResolveGBuffer — 1 thread per texel in [_Offset, _End). Writes the owner's
// attributes: interpolated inside the triangle, else at its closest border point.
// ---------------------------------------------------------------------------
[numthreads(64, 1, 1)]
void ResolveGBuffer(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x + _Offset;
    if (index >= _End) return;

    uint t = _GOwner[index];
    if (t == NoOwner)
    {
        _GPosition[index] = float4(0, 0, 0, 0);
        _GNormal[index]   = 0;
        return;
    }

    uint i0, i1, i2;
    float2 a, b, c;
    LoadTriangle(t, i0, i1, i2, a, b, c);

    float2 p = float2(index % _Width, index / _Width);
    float3 w = Barycentric(p, a, b, c);
    if (!Inside(w))
    {
        float dist2;
        w = ClosestOnBorder(p, a, b, c, dist2);
    }

    float3 position = w.x * _Positions[i0] + w.y * _Positions[i1] + w.z * _Positions[i2];
    float3 normal   = w.x * _Normals[i0]   + w.y * _Normals[i1]   + w.z * _Normals[i2];
    _GPosition[index] = float4(position, (float)(_Patches[i0] + 1));
    _GNormal[index]   = EncodeNormal(SafeNormalize(normal, _Normals[i0]));
}

// ---------------------------------------------------------------------------
// EvaluateCurvature — 1 thread per texel in [_Offset, _End).
//
// The result is the sum of two terms:
//
// 1) Smooth term (width = _Radius). Aggregates the surface samples within
//    _Radius of the texel's surface point p using the kernel
//    w = area * (1 - d^2 / r^2)^2 and estimates the mean curvature H
//    (n_avg = normalized weighted average sample normal):
//
//    Shading normals: H = sum(w * dot(n_i - n_avg, d_i)) / sum(w * |d_i|^2)
//                     Ratio of sums, not a mean of per-sample ratios: where dn
//                     stays finite as d -> 0, per-sample dn.d / d^2 diverges
//                     like 1/d and turns into heavy noise. Referencing n_avg
//                     rather than the texel's own normal keeps the response
//                     symmetric. Exact for spheres (dn = d / R).
//    Geometry:        H = 8 * dot(n_avg, p - centroid) / r^2
//                     (E[d^2] = r^2 / 4 under this kernel; exact for spheres)
//
//    Samples on the same mesh part but a different smooth patchId lie across a
//    hard edge and are skipped: hard edges belong to the edge term, so their
//    width does not depend on _Radius. Samples facing away from the texel
//    normal fade out over RejectionBand above _NormalRejection.
//
// 2) Edge term (width = _EdgeWidth). The strongest nearby hard edge of the
//    same part, weighted by (1 - dist^2 / width^2)^2 and by how well the texel
//    faces one of the edge's two faces.
//
// Output: _Strength * H * r + _EdgeStrength * edge. +1 = a sphere of radius r
// or a 90-degree convex edge at full strength; 0 = flat.
// ---------------------------------------------------------------------------
float SmoothCurvature(float3 p, float3 np, uint patchId, uint component)
{
    float r2    = _Radius * _Radius;
    float invR2 = 1.0 / r2;
    int3  cell  = (int3)floor((p - _GridOrigin) * _InvCellSize);

    float  sumW  = 0.0;
    float3 sumD  = float3(0, 0, 0); // sum(w * d)
    float3 sumN  = float3(0, 0, 0); // sum(w * n)
    float  sumND = 0.0;             // sum(w * dot(n, d))
    float  sumD2 = 0.0;             // sum(w * |d|^2)

    [loop]
    for (uint i = 0; i < 27; i++)
    {
        uint bucket = NeighbourBucket(cell, i, _HashMask);
        if (bucket == 0xFFFFFFFF) continue;

        uint2 range = _Buckets[bucket];
        uint end = range.x + range.y;
        [loop]
        for (uint s = range.x; s < end; s++)
        {
            SurfaceSample smp = _Samples[s];
            float3 d  = smp.position - p;
            float  d2 = dot(d, d);
            if (d2 >= r2) continue;

            if (smp.patchId != patchId)
            {
                uint sampleComponent = _PatchComponents[smp.patchId];
                if (sampleComponent == component) continue; // across a hard edge
                if (_SameComponentOnly != 0) continue;       // another mesh part
            }

            float facing = smoothstep(_NormalRejection, _NormalRejection + RejectionBand, dot(smp.normal, np));
            if (facing <= 0.0) continue;

            float k = 1.0 - d2 * invR2;
            float w = smp.weight * k * k * facing;

            sumW  += w;
            sumD  += w * d;
            sumN  += w * smp.normal;
            sumND += w * dot(smp.normal, d);
            sumD2 += w * d2;
        }
    }

    if (sumW <= 0.0)
        return 0.0;

    float3 nAvg = SafeNormalize(sumN, np);
    float geometry = -8.0 * dot(nAvg, sumD / sumW) / _Radius;
    // sum(w * dot(n_i - nAvg, d_i)) expanded so it accumulates in one pass.
    float shading = sumD2 > 0.0 ? (sumND - dot(nAvg, sumD)) / sumD2 * _Radius : 0.0;
    return lerp(shading, geometry, _GeometryWeight);
}

float EdgeCurvature(float3 p, float3 np, uint component)
{
    if (_EdgeCount == 0)
        return 0.0;

    float w2   = _EdgeWidth * _EdgeWidth;
    int3  cell = (int3)floor((p - _EdgeGridOrigin) * _EdgeInvCellSize);
    float best = 0.0;

    [loop]
    for (uint i = 0; i < 27; i++)
    {
        uint bucket = NeighbourBucket(cell, i, _EdgeHashMask);
        if (bucket == 0xFFFFFFFF) continue;

        uint2 range = _EdgeBuckets[bucket];
        uint end = range.x + range.y;
        [loop]
        for (uint s = range.x; s < end; s++)
        {
            EdgeSegment edge = _Edges[s];
            if (edge.component != component) continue;

            float3 ab = edge.b - edge.a;
            float  t  = saturate(dot(p - edge.a, ab) / max(dot(ab, ab), 1e-20));
            float3 c  = edge.a + ab * t - p;
            float  d2 = dot(c, c);
            if (d2 >= w2) continue;

            // Only surfaces adjacent to the edge, not e.g. the far side of a thin plate.
            float facing = smoothstep(EdgeFacingMin, EdgeFacingMax,
                                      max(dot(np, edge.faceNormalA), dot(np, edge.faceNormalB)));
            float k = 1.0 - d2 / w2;
            float v = edge.value * k * k * facing;
            if (abs(v) > abs(best)) best = v;
        }
    }
    return best;
}

[numthreads(64, 1, 1)]
void EvaluateCurvature(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x + _Offset;
    if (index >= _End) return;

    float4 g = _GPosition[index];
    if (g.w < 0.5)
    {
        _Result[index] = float2(0, 0);
        return;
    }

    float3 p         = g.xyz;
    uint   patchId     = (uint)(g.w + 0.5) - 1;
    uint   component = _PatchComponents[patchId];
    float3 np        = DecodeNormal(_GNormal[index]);

    float value = _Strength * SmoothCurvature(p, np, patchId, component)
                + _EdgeStrength * EdgeCurvature(p, np, component);
    _Result[index] = float2(value, 1.0);
}

// ---------------------------------------------------------------------------
// Downsample — 2x2 average of valid texels. 1 thread per destination texel.
// ---------------------------------------------------------------------------
[numthreads(64, 1, 1)]
void Downsample(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x + _Offset;
    if (index >= _End) return;

    uint x = index % _DstWidth;
    uint y = index / _DstWidth;

    float sum = 0.0;
    float coverage = 0.0;
    for (uint oy = 0; oy < 2; oy++)
    {
        for (uint ox = 0; ox < 2; ox++)
        {
            float2 s = _Src[(y * 2 + oy) * _SrcWidth + (x * 2 + ox)];
            sum      += s.x * s.y;
            coverage += s.y;
        }
    }

    _Dst[index] = coverage > 0.0 ? float2(sum / coverage, 1.0) : float2(0.0, 0.0);
}

// ---------------------------------------------------------------------------
// Blur — 3x3 Gaussian over valid texels only. Empty texels stay empty.
// ---------------------------------------------------------------------------
[numthreads(64, 1, 1)]
void Blur(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x + _Offset;
    if (index >= _End) return;

    float2 center = _Src[index];
    if (center.y < 0.5)
    {
        _Dst[index] = center;
        return;
    }

    int x = (int)(index % _SrcWidth);
    int y = (int)(index / _SrcWidth);
    int w = (int)_SrcWidth;

    float sum = 0.0;
    float weight = 0.0;
    for (int oy = -1; oy <= 1; oy++)
    {
        for (int ox = -1; ox <= 1; ox++)
        {
            int sx = x + ox;
            int sy = y + oy;
            if (sx < 0 || sy < 0 || sx >= w || sy >= w) continue;
            float2 s = _Src[sy * w + sx];
            float k = (ox == 0 ? 2.0 : 1.0) * (oy == 0 ? 2.0 : 1.0) * s.y;
            sum    += s.x * k;
            weight += k;
        }
    }

    _Dst[index] = float2(sum / weight, 1.0);
}

// ---------------------------------------------------------------------------
// Dilate — each empty texel takes the average of its valid 8-neighbours.
// Run N times to extend islands by N pixels.
// ---------------------------------------------------------------------------
[numthreads(64, 1, 1)]
void Dilate(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x + _Offset;
    if (index >= _End) return;

    float2 center = _Src[index];
    if (center.y > 0.5)
    {
        _Dst[index] = center;
        return;
    }

    int x = (int)(index % _SrcWidth);
    int y = (int)(index / _SrcWidth);
    int w = (int)_SrcWidth;

    float sum = 0.0;
    float count = 0.0;
    for (int oy = -1; oy <= 1; oy++)
    {
        for (int ox = -1; ox <= 1; ox++)
        {
            int sx = x + ox;
            int sy = y + oy;
            if (sx < 0 || sy < 0 || sx >= w || sy >= w) continue;
            float2 s = _Src[sy * w + sx];
            sum   += s.x * s.y;
            count += s.y;
        }
    }

    _Dst[index] = count > 0.0 ? float2(sum / count, 1.0) : float2(0.0, 0.0);
}
